{
  "name": "open-proxy-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Electron proxy core manager",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "wait-on": "latest"
  }
}
