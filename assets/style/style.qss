#frame_main {
    border: 1px solid #bbb;
    border-radius: 20px;
}

#centralwidget {
    background-color: rgba(230, 230, 230, 0);
}

QPushButton {
    color: white;
    border: 1px solid rgba(255, 255, 255, 160);
    border-radius: 8px;
    padding: 2px;
}
QPushButton:hover {
    border-color: gold;
    background-color: rgba(250, 250, 250, 200);
    color: green;
}
QPushButton:pressed {
    background-color: rgba(20, 20, 20, 180);
    border: 1px solid white;
}

QPushButton#topbar_close,
QPushButton#topbar_min,
QPushButton#topbar_max {
    min-width: 14px;
    max-width: 14px;
    min-height: 14px;
    max-height: 14px;
    border-radius: 7px;
    border: 1px solid transparent;
    outline: none;
    background-clip: padding;    
}
QPushButton#topbar_close { background-color: #ff5f57; }
QPushButton#topbar_min   { background-color: #ffbd2e; }
QPushButton#topbar_max   { background-color: #28c940; }
QPushButton#topbar_close:hover { border-color: #ff9999; }
QPushButton#topbar_min:hover   { border-color: #ffe680; }
QPushButton#topbar_max:hover   { border-color: #8cff7f; }
QPushButton#topbar_close:pressed { border-color: #cc4d4d; }
QPushButton#topbar_min:pressed   { border-color: #cc9900; }
QPushButton#topbar_max:pressed   { border-color: #1fa91f; }

QFrame#navbar:hover {
    border: 1px solid #FFFF33;
    border-radius: 10px;
}
QFrame#leftbar:hover {
    border: 1px solid #33FFFF;
    border-radius: 10px;
}
QFrame[type="nav_frame"]:hover {
    border: 1px solid #FF3333;
    border-radius: 10px;
}
QFrame[type="topbar"] {
    border: 1px solid #aaa;
    border-radius: 10px;
    background-color: transparent;
}
QFrame[type="topbar"]:hover {
    border: 1px solid #66FF66;
    border-radius: 10px;
    background-color: transparent;
}
QFrame#frame_terminal:hover {
    border: 1px solid #66FF66;
    border-radius: 10px;
}

QFrame#navbar {
    background-color: rgba(230, 230, 230, 0.15);
}
QFrame[type="nav_frame"] {
    background-color: rgba(230, 230, 230, 0.1);
    border: 1px solid rgba(80, 80, 80, 120);
    border-radius: 10px;
}

QTabBar {
    background: transparent;
}
QTabWidget::pane {
    background-color: transparent;
    border: 1px solid #bbb;
    border-radius: 10px;
}
QTabBar::tab {
    background: transparent;
    color: #2d2d2d;
    padding: 2px 6px;
    border: 1px solid #2d2d2d;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    border-color: blue;
}
QTabBar::tab:hover:!selected {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    border-color: green;
}
QTabWidget:hover {
    border: 1px solid #FF66FF;
}

QTableWidget, QListWidget, QTreeView {
    background-color: rgba(255, 255, 255, 50);
    border: none;
    color: white;
}
QTableWidget::viewport, QListWidget::viewport, QTreeView::viewport {
    background-color: transparent;
}
QTableWidget::item {
    padding: 5px;
    border: none;
}
QTableWidget::item:selected {
    background-color: #6ca6cd;
    color: grey;
}
QTableWidget::item:hover {
    background-color: #bdd7ee;
}
QHeaderView::section {
    background-color: #4a708b;
    color: white;
    padding: 6px;
    border: 1px solid #3d5b70;
    font-weight: bold;
}

QTextBrowser {
    background-color: rgba(255, 255, 255, 50);
    border: 1px solid #AAA;
    border-radius: 10px;
    color: white;
}
QTextBrowser:hover {
    border: 1px solid #FF33FF;
}
QTextBrowser#TextBrowser_bottom {
    background-color: rgba(255, 255, 255, 80);
    border: 1px solid #AAA;
    border-radius: 10px;
    color: white;
}

QScrollArea {
    background-color: rgba(0, 0, 0, 30);
    border: none;
    border-radius: 8px;
}
QWidget#scrollAreaWidgetContents {
    background-color: transparent;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 120);
}

QLabel {
    color: white;
    qproperty-alignment: 'AlignCenter';
}
QLabel[type="header"] {
    color: #CCFFCC;
}
QLabel#gif_label {
    border-radius: 20px;
    border: 2px solid rgba(255, 255, 255, 150);
    background-color: rgba(255, 255, 255, 30);
}

QLineEdit {
    background-color: rgba(255, 255, 255, 30);
    border-radius: 10px;
    padding: 2px 10px;
    color: white;
    font-size: 16px;
    border: 1px solid rgba(255, 255, 255, 50);
    selection-background-color: rgba(255, 255, 255, 100);
}
QLineEdit:hover {
    background-color: rgba(255, 255, 255, 40);
    border: 1px solid lightblue;
}
QLineEdit:focus {
    background-color: rgba(255, 255, 255, 50);
    border: 1px solid blue;
    outline: none;
}

QComboBox {
    background-color: rgba(255, 255, 255, 30);
    border-radius: 10px;
    padding: 2px 30px 2px 10px;
    color: white;
    font-size: 14px;
    border: 1px solid rgba(255, 255, 255, 50);
    combobox-popup: 0;
}
QComboBox:hover {
    background-color: rgba(255, 255, 255, 40);
    border: 1px solid blueviolet;
}
QComboBox:focus {
    background-color: rgba(255, 255, 255, 50);
    border: 1px solid blue;
}
QComboBox QAbstractItemView {
    background-color: rgba(255, 255, 255, 20);
    border-radius: 8px;
    padding: 4px;
    color: white;
    selection-background-color: rgba(100, 180, 255, 100);
    selection-color: white;
    outline: none;
}

QScrollBar:horizontal, QScrollBar:vertical {
    border: none;
    background: rgba(255, 255, 255, 10);
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 50);
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 80);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QSpinBox {
    background-color: rgba(255, 255, 255, 30);
    border-radius: 10px;
    padding: 2px 30px 2px 10px;
    color: white;
    font-size: 14px;
    border: 2px solid rgba(255, 255, 255, 50);
}
QSpinBox:hover {
    background-color: rgba(255, 255, 255, 40);
    border: 2px solid rgba(255, 255, 255, 80);
}
QSpinBox:focus {
    background-color: rgba(255, 255, 255, 50);
    border: 2px solid rgba(100, 180, 255, 150);
}
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: padding;
    width: 25px;
    background-color: rgba(255, 255, 255, 10);
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: rgba(255, 255, 255, 20);
}

QRadioButton, QCheckBox {
    color: white;
}QCheckBox::indicator, QRadioButton::indicator {
    width: 12px;
    height: 12px;
}QCheckBox::indicator:unchecked {
    background-color: transparent;
    border: 1px solid gray;
    border-radius: 6px;
}QCheckBox::indicator:checked {
    background-color: #3399ff;
    border: 1px solid green;
    border-radius: 6px;
}QRadioButton::indicator:unchecked {
    border: 1px solid green;
    background-color: transparent;
    border-radius: 6px;
}QRadioButton::indicator:checked {
    background-color: #3399ff;
    border: 1px solid green;
    border-radius: 6px;
}

QMessageBox QLabel, QFileDialog QLabel {
    color: black;
    font-size: 12px;
}QMessageBox QPushButton, QFileDialog QPushButton {
    color: black;
}QFileDialog QLineEdit {
    color: black;
    font-size: 12px;
    background: white;
}QFileDialog QListView, QFileDialog QTreeView {
    color: black;
    font-size: 12px;
    background: white;
}QFileDialog QComboBox {
    color: black;
}

QTextEdit {
    background: transparent;
    color: white;
    border: solid 1px #3d5b70;
    border-radius: 10px;
}

QToolTip {
    color: #EEE;
    background-color: rgba(30, 30, 30, 180);
    border: 1px solid #AAA;
    padding: 5px;
    border-radius: 3px;
}

QGraphicsView{
    background-color: transparent;
    border: none;
}

