/* universal effect */
#frame_main {
    border: 1px solid #aaa;
    border-radius: 20px;
}

#centralwidget {
    background-color: rgba(255, 255, 255, 0);
}

/* buttons */
QPushButton {
    color: #222;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    padding: 2px;
    background-color: rgba(255, 255, 255, 0.6);
}
QPushButton:hover {
    border-color: gold;
    background-color: rgba(255, 255, 255, 0.8);
    color: green;
}
QPushButton:pressed {
    background-color: rgba(200, 200, 200, 0.7);
    border: 1px solid #666;
}

QPushButton#topbar_close,
QPushButton#topbar_min,
QPushButton#topbar_max {
    min-width: 14px;
    max-width: 14px;
    min-height: 14px;
    max-height: 14px;
    border-radius: 7px;
    border: 1px solid transparent;
    outline: none;
    background-clip: padding;    
}
QPushButton#topbar_close { background-color: #ff5f57; }
QPushButton#topbar_min   { background-color: #ffbd2e; }
QPushButton#topbar_max   { background-color: #28c940; }
QPushButton#topbar_close:hover { border-color: #ff9999; }
QPushButton#topbar_min:hover   { border-color: #ffe680; }
QPushButton#topbar_max:hover   { border-color: #8cff7f; }
QPushButton#topbar_close:pressed { border-color: #cc4d4d; }
QPushButton#topbar_min:pressed   { border-color: #cc9900; }
QPushButton#topbar_max:pressed   { border-color: #1fa91f; }

QPushButton#topbar_close {
    background-color: #ff6666;
}
QPushButton#topbar_min {
    background-color: #99ff99;
}
QPushButton#topbar_max {
    background-color: #ffff99;
}

/* nav frames */
QFrame#navbar {
    background-color: rgba(255,255,255,0.6);
}
QFrame#navbar:hover {
    border: 1px solid #cccc33;
    border-radius: 10px;
}
QFrame#leftbar {
    background-color: rgba(255,255,255,0.6);
}
QFrame#leftbar:hover {
    border: 1px solid #33cccc;
    border-radius: 10px;
}
QFrame[type="nav_frame"] {
    background-color: rgba(255,255,255,0.5);
    border: 1px solid rgba(80,80,80,120);
    border-radius: 10px;
}
QFrame[type="nav_frame"]:hover {
    border: 1px solid #ff6666;
}

QFrame[type="topbar"] {
    border: 1px solid #aaa;
    border-radius: 10px;
    background-color: transparent;
}
QFrame[type="topbar"]:hover {
    border: 1px solid #66cc66; 
}

QFrame#frame_terminal:hover {
    border: 1px solid #66cc66;
}

/* tabs */
QTabBar {
    background: transparent;
}
QTabWidget::pane {
    background-color: transparent;
    border: 1px solid #bbb;
    border-radius: 10px;
}
QTabBar::tab {
    background: rgba(255, 255, 255, 0.6);
    color: #222;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    padding: 2px 6px;
    border: 1px solid #888;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: rgba(255, 255, 255, 0.8);
    color: #000;
    border-color: blue;
}
QTabBar::tab:hover:!selected {
    background: rgba(255, 255, 255, 0.7);
    color: #000;
    border-color: green;
}

/* table, list, tree */
QTableWidget, QListWidget, QTreeView {
    background-color: rgba(255, 255, 255, 0.6);
    border: none;
    color: #222;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
}
QTableWidget::viewport, QListWidget::viewport, QTreeView::viewport {
    background-color: transparent;
}
QTableWidget::item {
    padding: 5px;
    border: none;
}
QTableWidget::item:selected {
    background-color: #cce5ff;
    color: #000;
}
QTableWidget::item:hover {
    background-color: #e6f0ff;
}
QHeaderView::section {
    background-color: #cce0ff;
    color: #222;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    padding: 6px;
    border: 1px solid #bbb;
    font-weight: bold;
}

/* text browsers */
QTextBrowser {
    background-color: rgba(255, 255, 255, 0.6);
    border: 1px solid #AAA;
    border-radius: 10px;
    color: #222;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
}
QTextBrowser:hover {
    border: 1px solid #ff66ff;
}
QTextBrowser#TextBrowser_bottom {
    background-color: rgba(255, 255, 255, 0.8);
    border: 1px solid #AAA;
    border-radius: 10px;
    color: #222;
}

/* labels */
QLabel {
    color: #222;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.15);
    qproperty-alignment: 'AlignCenter';
}
QLabel[type="header"] {
    color: #006633;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
}
QLabel#gif_label {
    border-radius: 20px;
    border: 2px solid rgba(0, 0, 0, 0.3);
    background-color: rgba(255, 255, 255, 0.4);
}

/* input fields */
QLineEdit, QComboBox, QSpinBox {
    background-color: rgba(255, 255, 255, 0.6);
    border-radius: 10px;
    padding: 2px 10px;
    color: #222;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    font-size: 14px;
    border: 2px solid rgba(0, 0, 0, 0.2);
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    background-color: rgba(255, 255, 255, 0.7);
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    background-color: rgba(255, 255, 255, 0.8);
    border: 2px solid rgba(100, 180, 255, 0.8);
}

/* checkboxes and radio buttons */
QCheckBox, QRadioButton {
    color: #222;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
}
QCheckBox::indicator {
    width: 12px;
    height: 12px;
}
QCheckBox::indicator:unchecked {
    background-color: transparent;
    border: 1px solid gray;
    border-radius: 6px;
}
QCheckBox::indicator:checked {
    background-color: #3399ff;
    border: 1px solid green;
    border-radius: 6px;
}
QRadioButton::indicator {
    width: 12px;
    height: 12px;
}
QRadioButton::indicator:unchecked {
    border: 1px solid green;
    background-color: transparent;
    border-radius: 6px;
}
QRadioButton::indicator:checked {
    background-color: #3399ff;
    border: 1px solid green;
    border-radius: 6px;
}

/* tooltip */
QToolTip {
    color: #222;
    text-shadow: 1px 1px 2px rgba(255,255,255,0.5);
    background-color: rgba(255, 255, 200, 0.9);
    border: 1px solid #AAA;
    padding: 5px;
    border-radius: 3px;
}

QGraphicsView{
    background-color: transparent;
    border: none;
}
